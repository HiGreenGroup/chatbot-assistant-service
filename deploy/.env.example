# Copiar como .env en la carpeta del ambiente en el servidor y completar.
# Los valores de ejemplo son de beta; en producción van los indicados en cada comentario.

# Separa contenedores y volúmenes de cada ambiente si corren en el mismo servidor.
# Producción: chatbot-prod
COMPOSE_PROJECT_NAME=chatbot-beta

# Imagen publicada por la CI: develop (push a develop) o main (push a main).
# Producción: main
IMAGE_TAG=develop

# Puerto del servidor donde queda expuesto el contenedor.
# Producción: 4011
HOST_PORT=4012

# Clave de OpenAI (requerida) y de respaldo (opcional).
OPENAI_API_KEY=
OPENAI_API_KEY_FALLBACK=

# Modelos (opcionales).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Dominio(s) del frontend de este ambiente, separados por coma (exactos, sin "/" final).
# Producción: https://empleoservicio.com,https://www.empleoservicio.com
ALLOWED_ORIGINS=https://beta.empleoservicio.com
